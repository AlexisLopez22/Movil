<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemCancionLista"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/music_card">

    <ImageView
        android:id="@+id/imgCancionLista"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerCrop"
        android:background="#151924"
        android:contentDescription="Imagen cancion" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvTituloLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre de la Canción"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvArtistaLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del Artista"
            android:textColor="#6A7B92"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOpcionesCancion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⋮"
        android:textColor="#6A7B92"
        android:textSize="22sp"
        android:padding="8dp" />

</LinearLayout>