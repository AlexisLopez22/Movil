<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0F15"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subir Nueva Canción"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="24dp">

            <ImageView
                android:id="@+id/imgPortadaPreview"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="#1A202B"
                android:src="@android:drawable/ic_menu_camera"
                android:scaleType="center"
                android:contentDescription="Portada" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toca para subir la portada"
                android:textColor="#929BAD"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />


            <EditText
                android:id="@+id/etTituloCancion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="#1A202B"
                android:hint="Título de la canción"
                android:inputType="textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#929BAD"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etGenero"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="#1A202B"
                android:hint="Género (Ej. Rock, Reggaetón)"
                android:inputType="textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#929BAD"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/btnSeleccionarAudio"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="20dp"
                android:background="#1A202B"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar archivo de audio (.mp3)"
                    android:textColor="#2CE4F5"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNombreArchivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ningún archivo seleccionado"
                    android:textColor="#929BAD"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPublicar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="30dp"
                android:backgroundTint="#2CE4F5"
                android:text="Publicar Canción"
                android:textColor="#0D0F15"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>