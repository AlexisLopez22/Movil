<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#13161F">

    <!-- BARRA DE NAVEGACIÓN -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#1E2433"
        android:elevation="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AudioFile"
            android:textColor="#2CE4F5"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inicio"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="20dp" />

        <TextView
            android:id="@+id/tvPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 Mi Perfil"
            android:textColor="#2CE4F5"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/profile_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

    </LinearLayout>


    <!-- CONTENIDO -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="25dp"
            android:paddingBottom="40dp">


            <!-- ACCESOS DIRECTOS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accesos Directos &amp; Recientes"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:layout_marginBottom="15dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <include layout="@layout/item_cancion" />

                    <include layout="@layout/item_cancion" />

                    <include layout="@layout/item_cancion" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- MÁS ESCUCHADO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lo más escuchado en la aplicación"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="15dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <include layout="@layout/item_cancion" />

                    <include layout="@layout/item_cancion" />

                    <include layout="@layout/item_cancion" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- PARA TI -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Para Ti (Basado en tus gustos)"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="15dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <include layout="@layout/item_cancion" />

                    <include layout="@layout/item_cancion" />

                    <include layout="@layout/item_cancion" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- LO-FI -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explorar por Género: Lo-Fi"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="15dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <include layout="@layout/item_cancion" />

                    <include layout="@layout/item_cancion" />

                    <include layout="@layout/item_cancion" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- ARTISTA -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explorar por Artista: Porter Robinson"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="15dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <include layout="@layout/item_cancion" />

                    <include layout="@layout/item_cancion" />

                    <include layout="@layout/item_cancion" />

                </LinearLayout>

            </HorizontalScrollView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>